# ========================================
# CodeQuizHub Production Environment
# ========================================
# Copy this file to .env and fill in your values
#
#   cp .env.production .env
#   docker compose --env-file .env up -d
# ========================================

# PostgreSQL password (CHANGE THIS)
DB_PASSWORD=replace-with-strong-random-password

# JWT signing secret (CHANGE THIS - minimum 32 characters)
JWT_SECRET=replace-with-random-64-char-secret-at-least-32-chars

# Debug mode (must be false in production)
DEBUG=false

# Allowed CORS origins (your frontend domain)
CORS_ORIGINS=["https://your-domain.com"]

# Database backup directory (optional)
# BACKUP_DIR=./backups
